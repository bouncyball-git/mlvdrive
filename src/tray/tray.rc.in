// The tray app's resources (configured by CMake: the paths are absolute).
#include <windows.h>

1 ICON "@MLVDRIVE_ICON_ON@"
2 ICON "@MLVDRIVE_ICON_OFF@"
1 RT_MANIFEST "@MLVDRIVE_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MLV Drive"
            VALUE "ProductName", "MLV Drive"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "mlvdrive_tray"
            VALUE "OriginalFilename", "mlvdrive_tray.exe"
            VALUE "LegalCopyright", "GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
